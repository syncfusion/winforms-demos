<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>WeatherAnalysis</AssemblyName>
    <RootNamespace>WeatherAnalysis</RootNamespace>
    <Win32Manifest>app.manifest</Win32Manifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="**\*.png" />
    <Resource Include="**\*.ico" />
    <Resource Include="**\*.gif" />
    <Resource Remove="Images\Rainy.png" />
    <Resource Remove="Images\Rain_Animate.gif" />
    <Resource Remove="Images\Snowy.png" />
    <Resource Remove="Images\Snow_Animation.gif" />
    <Resource Remove="Images\Sun.png" />
    <Resource Remove="Images\Sun_Animation.gif" />
    <Resource Remove="Images\Umberlla_animate.gif" />
    <EmbeddedResource Include="Images\Rainy.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Images\Rain_Animate.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Images\Snowy.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Images\Snow_Animation.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Images\Sun.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Images\Sun_Animation.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Images\Umberlla_animate.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <PackageReference Include="Syncfusion.Chart.Base" Version="19.3.0.43" />
    <PackageReference Include="Syncfusion.Chart.Windows" Version="19.3.0.43" />
    <PackageReference Include="Syncfusion.Core.WinForms" Version="19.3.0.43" />
    <PackageReference Include="Syncfusion.Grid.Grouping.Windows" Version="19.3.0.43" />
    <PackageReference Include="Syncfusion.Grid.Windows" Version="19.3.0.43" />
    <PackageReference Include="Syncfusion.Grouping.Base" Version="19.3.0.43" />
    <PackageReference Include="Syncfusion.Licensing" Version="19.3.0.43" />
    <PackageReference Include="Syncfusion.Shared.Base" Version="19.3.0.43" />
    <PackageReference Include="Syncfusion.Shared.Windows" Version="19.3.0.43" />
  </ItemGroup>
</Project>