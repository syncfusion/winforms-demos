<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>CustomCollections</AssemblyName>
    <RootNamespace>CustomCollections</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="CustomCollections.exe.manifest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="CustomCollections.exe.manifest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Syncfusion.Chart.Base" Version="19.1.0.54" />
    <PackageReference Include="Syncfusion.Chart.Windows" Version="19.1.0.54" />
    <PackageReference Include="Syncfusion.Shared.Base" Version="19.1.0.54" />
    <PackageReference Include="Syncfusion.Licensing" Version="19.1.0.54" />
  </ItemGroup>
</Project>